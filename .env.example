# 复制本文件为 .env，填入本机实际值后使用
# 说明：Spring Boot 通过 application.yml 中的 ${变量名} 占位符读取同名环境变量，
#       环境变量优先级最高，会覆盖 application.yml / application-local.yml 的同名配置。

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=movie_dashboard
DB_USERNAME=root
DB_PASSWORD=

# ---------- 服务端口 ----------
# 注意：实际端口在 application.yml 中固定为 8081（需与 nginx.conf 的 proxy_pass 对齐）。
# 如需临时换端口，请直接修改 application.yml 的 server.port，不要用环境变量。

# ---------- 可选调优 ----------
# JPA 自动建表策略：update / validate / none
DDL_AUTO=update
# 是否打印 SQL
SHOW_SQL=false
# 日志级别：info / debug / warn
LOG_LEVEL=info
# HikariCP 连接池最大连接数
DB_POOL_MAX=10
# 默认激活的配置文件：local（本地） / prod（生产）
SPRING_PROFILES_ACTIVE=local
