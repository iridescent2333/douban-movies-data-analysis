# ============================================================
# 豆瓣电影数据洞察看板 — 根目录 .gitignore
# 原则：源码 + 配置模板 + 文档入库；本地环境产物 / 二进制 / 凭据 / 日志不入库
# ============================================================

# ---- Maven 编译产物 ----
backend/target/
*.class

# ---- IDE 个人配置 ----
.idea/
.vscode/
*.iml

# ---- 本地敏感配置（含真实账号密码，严禁入库）----
application-local.yml
backend/src/main/resources/application-local.yml
.env
*.local.yml

# ---- 数据库本地文件 ----
backend/data/
data/
*.mv.db
*.trace.db

# ---- Nginx 二进制发行版（每人自行下载）----
frontend/nginx-1.26.2/

# ---- 日志 / 进程文件 ----
*.log
*.pid
logs/

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- Python ----
__pycache__/
*.pyc

# ---- 临时文件 ----
*.tmp
*.temp
